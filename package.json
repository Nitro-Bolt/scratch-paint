{
  "name": "scratch-paint",
  "version": "2.1.61",
  "packageManager": "pnpm@10.33.0",
  "description": "Graphical User Interface for the Scratch 3.0 paint editor, which is used to make and edit sprites for use in projects.",
  "main": "./dist/scratch-paint.js",
  "browser": "./src/index.js",
  "scripts": {
    "build": "node scripts/clean.js && rspack build",
    "clean": "node scripts/clean.js",
    "i18n:push": "tx-push-src scratch-editor paint-editor ./translations/en.json",
    "i18n:src": "node scripts/clean.js --i18n && babel src --out-file tmp.js && node scripts/clean.js --tmp && node scripts/build-i18n-source.js ./translations/messages/ ./translations/",
    "lint": "eslint . --ext .js,.jsx",
    "start": "rspack serve --config rspack.config.js --config-name playground",
    "test": "jest --reporters=default",
    "unit": "jest --reporters=default",
    "watch": "rspack build --watch"
  },
  "author": "Massachusetts Institute of Technology",
  "license": "GPL-3.0",
  "homepage": "https://github.com/LLK/scratch-paint#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/LLK/scratch-paint.git"
  },
  "dependencies": {
    "@nitro-bolt/paper": "^0.13.1",
    "@turbowarp/nanolog": "1.0.1",
    "classnames": "2.5.1",
    "keymirror": "0.1.1",
    "lodash.bindall": "4.4.0",
    "lodash.omit": "4.5.0",
    "parse-color": "1.0.0",
    "prop-types": "^15.5.10"
  },
  "peerDependencies": {
    "react": "^16",
    "react-dom": "^16",
    "react-intl": "^2",
    "react-intl-redux": "^0.7",
    "react-popover": "^0.5",
    "react-redux": "^5",
    "react-responsive": "^5",
    "react-style-proptype": "^3",
    "react-tooltip": "^3",
    "redux": "^3",
    "scratch-render-fonts": "^1.0.0-prerelease.20210401210003"
  },
  "devDependencies": {
    "@babel/cli": "7.28.6",
    "@babel/core": "7.28.6",
    "@babel/eslint-parser": "7.28.5",
    "@babel/plugin-transform-object-rest-spread": "7.28.6",
    "@babel/preset-env": "7.28.6",
    "@babel/preset-react": "7.28.5",
    "@rspack/cli": "2.2.9",
    "@rspack/core": "2.2.9",
    "@rspack/dev-server": "2.2.1",
    "autoprefixer": "10.6.1",
    "babel-jest": "29.7.0",
    "babel-plugin-react-intl": "3.0.1",
    "css-loader": "7.1.5",
    "eslint": "8.57.1",
    "eslint-config-scratch": "9.0.3",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "jest": "^27.0.5",
    "jest-canvas-mock": "2.5.8",
    "jest-junit": "17.0.0",
    "postcss": "8.5.6",
    "postcss-import": "16.1.1",
    "postcss-loader": "8.2.1",
    "postcss-simple-vars": "7.0.1",
    "raf": "3.4.1",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "react-intl": "2.9.0",
    "react-intl-redux": "2.0.0",
    "react-popover": "0.5.10",
    "react-redux": "5.1.0",
    "react-responsive": "5.0.0",
    "react-style-proptype": "3.2.2",
    "react-test-renderer": "16.14.0",
    "react-tooltip": "3.8.4",
    "redux": "3.7.2",
    "redux-mock-store": "1.5.4",
    "redux-throttle": "0.1.1",
    "regenerator-runtime": "0.14.1",
    "scratch-l10n": "6.1.132",
    "scratch-render-fonts": "1.0.254",
    "style-loader": "4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "core-js"
    ]
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "setupFiles": [
      "jest-canvas-mock",
      "raf/polyfill"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/test/__mocks__/fileMock.js",
      "\\.(css|less)$": "<rootDir>/test/__mocks__/styleMock.js"
    }
  },
  "jest-junit": {
    "outputDirectory": "./test/results"
  },
  "browserslist": [
    "last 3 versions",
    "Safari >= 8",
    "iOS >= 8"
  ]
}
